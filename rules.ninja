# This file contains the infrastructure used to compile for all the different architectures we
# support. You may (or may not) need to edit this file to get things to compile.
#
# Look for the string "TASK :: " to navigate between parts of the file that need editing.



# BUILD NOTE: This is currently built for a clang-based workflow! This is to simplify the build
# process by running everything through one compiler.
#
# This requires:
#  - clang (set by $cc)
#  - ARM sysroot (set by $arm_cc_explicit)
#
#
# It's also easy to reconfigure this to use GCC for cross-compilation:
#  - compiler for individual targets can be overridden ($arm_cc, $host_cc)
#  - individual targets have compiler-specific flags variables ($arm_cc_explicit, $host_cc_explicit)
# Generally: look for sections of this file titled `# XYZ COMPILER CONFIGURATION`




include util.ninja




# --------------------------------------------------------------------------------------------------
# GENERIC
cc = /opt/homebrew/opt/llvm@23/bin/clang
ld = ld.lld
objcopy = /opt/homebrew/opt/llvm@23/bin/llvm-objcopy




# --------------------------------------------------------------------------------------------------
# ARMv6 COMPILER CONFIGURATION
#
# TASK :: Edit these in accordance with your system

# arm_cc = /Applications/ArmGNUToolchain/15.2.rel1/arm-none-eabi/bin/arm-none-eabi-gcc
# arm_ld = arm-none-eabi-ld
arm_cc = ${cc}
arm_ld = ${ld}
arm_objcopy = ${objcopy}
# Compiler-specific flags.
#
# Example (Clang):
#
#     --target=arm-none-eabi --sysroot=/usr/lib/arm-none-eabi -fshort-enums
#
#   is required for clang on my machine, but --target isn't a GCC option and the other options would
#   be superfluous
# 
# Example (GCC):
#
#     -nostartfiles
# 
#arm_cc_explicit = --target=arm-none-eabi --sysroot /usr/lib/arm-none-eabi -fshort-enums
arm_cc_explicit = --target=arm-none-eabi -fshort-enums $
                  --sysroot /Applications/ArmGNUToolchain/15.2.rel1/arm-none-eabi/bin/../arm-none-eabi $
                  --gcc-install-dir=/Applications/ArmGNUToolchain/15.2.rel1/arm-none-eabi/lib/gcc/arm-none-eabi/15.2.1
# arm_cc_explicit = -nostartfiles




# --------------------------------------------------------------------------------------------------
# ARMv6 COMPILER RULES

arm_cflags    = -Wall -O3 -I. -ffreestanding -nostdlib -std=gnu23 -march=armv6zk $
                -mcpu=arm1176jzf-s -fdiagnostics-color ${arm_cc_explicit} -fomit-frame-pointer
arm_ldflags    = -z noexecstack --gc-sections -static

# params: cflags_ext
rule arm_cc
  command = ${arm_cc} -MD -MF ${out}.d ${arm_cflags} ${cflags_ext} -D_CFLAGS_="\"${arm_cflags} ${cflags_ext}\"" -c ${in} -o ${out}
  deps = gcc
  depfile = ${out}.d
  description = ${_green}[ARM_CC]${_reset} ${out}

rule arm_mklib
  command = llvm-ar rcs ${out} ${in}
  description = ${_green}[ARMAR]${_reset} ${out}

# params: ldflags_ext
rule arm_link
  command = ${arm_ld} ${arm_ldflags} ${ldflags_ext} ${in} ${libs} -o ${out}
  description = ${_green}[ARMLD]${_reset} ${out}

rule arm_objcopy
  command = ${arm_objcopy} -O binary ${in} ${out}
  description = ${_green}[ARMOCP]${_reset} ${out}

rule pi-install
  command = bin/pi-install ${in}
  description = ${_green}[PI-INSTALL]${_reset} ${in}

rule arm_xz
  command = xz --arm -k --threads=1 -9 --check=crc32 --lzma2=dict=1Mi $in -c > $out
  description = ${_green}[ARMXZ]${_reset} ${out}

rule arm_mergelibs
  command = scripts/mergelibs.mri.sh ${out} ${in} | arm-none-eabi-ar -M
  description = ${_green}[ARMAR_MRI]${_reset} ${out} < ${in}




# --------------------------------------------------------------------------------------------------
# HOST COMPILER CONFIGURATION
#
# TASK :: Edit these in accordance with your system

host_cc = ${cc}
host_ld = ${cc}
host_cc_explicit = -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk $
  -resource-dir /opt/homebrew/opt/llvm/lib/clang/23/




# --------------------------------------------------------------------------------------------------
# HOST COMPILER RULES

host_cflags = -std=c2y -O2 -I. -march=native ${host_cc_explicit}
host_ldflags =

rule host_cc
  command = ${host_cc} -MD -MF ${out}.d ${host_cflags} ${cflags_ext} -c ${in} -o ${out}
  deps = gcc
  depfile = ${out}.d
  description = ${_magenta}[HOSTCC]${_reset} ${out}

rule host_link
  command = ${host_ld} ${host_ldflags} ${ldflags_ext} ${in} ${libs} -o ${out}
  description = ${_magenta}[HOSTLD]${_reset} ${out}




# --------------------------------------------------------------------------------------------------
# MISC. UTILITIES

rule mkdir
  command = mkdir -p ${out}
  description = ${_cyan}[MKDIR]${_reset} ${out}
