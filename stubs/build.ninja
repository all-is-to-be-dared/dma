# -------------------------------------------------------------------------------------------------
# TARGET: stubs/blink.bin

build stubs/blink.bin: bcm2835_objcopy stubs/blink.elf
build stubs/blink.elf: bcm2835_link stubs/blink.o
build stubs/blink.o: bcm2835_cc stubs/blink.S

default stubs/blink.bin




# -------------------------------------------------------------------------------------------------
# TARGET: stubs/hang.bin

build stubs/hang.elf.xz: bcm2835_xz stubs/hang.elf
build stubs/hang.elf: bcm2835_link stubs/hang.o
build stubs/hang.o: bcm2835_cc stubs/hang.S

default stubs/hang.elf.xz
