# -------------------------------------------------------------------------------------------------
# XZ-EMBEDDED

d = build/bcm2835/pup/
s = pup/xz-embedded/

xz_cflags = -I$s -DXZ_DEC_PREALLOC=1 -DXZ_DEC_BCJ=1

build ${d}/libxz_embedded.a: arm_mklib ${d}/xz_crc32.o $
  ${d}/xz_dec_stream.o ${d}/xz_dec_lzma2.o ${d}/xz_dec_bcj.o

build ${d}/xz_crc32.o: arm_cc ${s}/xz_crc32.c
  cflags_ext = ${xz_cflags}
build ${d}/xz_dec_stream.o: arm_cc ${s}/xz_dec_stream.c
  cflags_ext = ${xz_cflags}
build ${d}/xz_dec_lzma2.o: arm_cc ${s}/xz_dec_lzma2.c
  cflags_ext = ${xz_cflags}
build ${d}/xz_dec_bcj.o: arm_cc ${s}/xz_dec_bcj.c
  cflags_ext = ${xz_cflags} -DXZ_DEC_ARM=1

default ${d}/libxz_embedded.a
