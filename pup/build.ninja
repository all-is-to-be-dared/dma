# Next, pull in information for external (non-vendored) packages we depend on
include pup/config.ninja




subninja pup/xz-embedded/build.ninja




# --------------------------------------------------------------------------------------------------
# TARGET: pup/bcm2835 .{elf,bin} {.xz,}

builddir = build/bcm2835/pup/

build pup/bcm2835.bin.xz: arm_xz pup/bcm2835.bin
build pup/bcm2835.bin: arm_objcopy pup/bcm2835.elf
build pup/bcm2835.elf.xz: arm_xz pup/bcm2835.elf

build pup/bcm2835.elf: arm_link $
  ${builddir}/fsm.o ${builddir}/crc.o ${builddir}/fcs.o $
  ${builddir}/bcm2835.o ${builddir}/bin.o ${builddir}/elf.o $
  ${builddir}/elf_loader.o ${builddir}/libxz_embedded.a $
  bcm2835/libplatform.a bcm2835/libc.a $
  | pup/bcm2835.ld
  ldflags_ext = -Tpup/bcm2835.ld
  libs = bcm2835/libgcc.a 

build ${builddir}/bcm2835.o: arm_cc pup/bcm2835.c
build ${builddir}/elf_loader.o: arm_cc pup/elf_loader.c

build ${builddir}/bin.o: arm_cc pup/trampolines/bin.bcm2835.S
build ${builddir}/elf.o: arm_cc pup/trampolines/elf.bcm2835.S
  cflags_ext = -I. -Inewlib-cygwin/include -Inewlib-cygwin/newlib/libc/string

build ${builddir}/fsm.o: arm_cc pup/fsm.c
  cflags_ext = -DNO_UPLOAD=1
build ${builddir}/crc.o: arm_cc pup/crc.c
build ${builddir}/fcs.o: arm_cc pup/fcs.c

default pup/bcm2835.elf pup/bcm2835.elf.xz pup/bcm2835.bin pup/bcm2835.bin.xz




# --------------------------------------------------------------------------------------------------
# TARGET: bin/pup

builddir = build/host/pup/

build bin/pup: host_link $
  ${builddir}/host.o ${builddir}/host_macos.o ${builddir}/host_linux.o $
  ${builddir}/fsm.o ${builddir}/crc.o ${builddir}/fcs.o ${host_xz_lib}
  libs = ${pup_libs_host}
build ${builddir}/host.o: host_cc pup/host.c
  cflags_ext = ${host_xz_incl}
build ${builddir}/host_macos.o: host_cc pup/host_macos.c
build ${builddir}/host_linux.o: host_cc pup/host_linux.c

build ${builddir}/fsm.o: host_cc pup/fsm.c
  cflags_ext = -DNO_DOWNLOAD=1
build ${builddir}/crc.o: host_cc pup/crc.c
build ${builddir}/fcs.o: host_cc pup/fcs.c

default bin/pup
