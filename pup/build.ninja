# Next, pull in information for external (non-vendored) packages we depend on
include pup/config.ninja




# --------------------------------------------------------------------------------------------------
# TARGET: pup/bcm2835


build pup/bcm2835: phony pup/bcm2835.elf pup/bcm2835.elf.xz pup/bcm2835.bin pup/bcm2835.bin.xz

build pup/bcm2835.bin.xz: arm_xz pup/bcm2835.bin
build pup/bcm2835.bin: arm_objcopy pup/bcm2835.elf
build pup/bcm2835.elf.xz: arm_xz pup/bcm2835.elf
build pup/bcm2835.elf: arm_link $
  pup/fsm.arm1176.o pup/crc.arm1176.o pup/fcs.arm1176.o $
  pup/bcm2835.o pup/trampolines/bcm2835.o pup/trampolines/elf.bcm2835.o pup/elf_loader.bcm2835.o $
  pup/xz-embedded/libxz_embedded.bcm2835.a $
  bcm2835/libplatform.a bcm2835/libc.a $
  | pup/bcm2835.ld
  ldflags_ext = -Tpup/bcm2835.ld
  libs = bcm2835/libgcc.a 
build pup/bcm2835.o: arm_cc pup/bcm2835.c
build pup/trampolines/bcm2835.o: arm_cc pup/trampolines/bcm2835.S
build pup/trampolines/elf.bcm2835.o: arm_cc pup/trampolines/elf.bcm2835.S
  cflags_ext = -I. -Inewlib-cygwin/include -Inewlib-cygwin/newlib/libc/string

build pup/elf_loader.bcm2835.o: arm_cc pup/elf_loader.c

build pup/fsm.arm1176.o: arm_cc pup/fsm.c
  cflags_ext = -DNO_UPLOAD=1
build pup/crc.arm1176.o: arm_cc pup/crc.c
build pup/fcs.arm1176.o: arm_cc pup/fcs.c

default pup/bcm2835




# --------------------------------------------------------------------------------------------------
# TARGET: bin/pup

build bin/pup: host_link $
  pup/host.o pup/host_macos.o pup/host_linux.o $
  pup/fsm.host.o pup/crc.host.o pup/fcs.host.o $
  | bin/
  cflags_ext = ${host_xz_lib}
  libs = -llzma ${pup_libs_host}
build pup/host.o: host_cc pup/host.c
  cflags_ext = ${host_xz_incl}
build pup/host_macos.o: host_cc pup/host_macos.c
build pup/host_linux.o: host_cc pup/host_linux.c

build pup/fsm.host.o: host_cc pup/fsm.c
  cflags_ext = -DNO_DOWNLOAD=1
build pup/crc.host.o: host_cc pup/crc.c
build pup/fcs.host.o: host_cc pup/fcs.c

default bin/pup




# --------------------------------------------------------------------------------------------------
# TARGET GROUP: xz-embedded

include pup/xz-embedded/build.ninja
