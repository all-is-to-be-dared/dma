#! /usr/bin/env ninja
#
# FILE /build.ninja
# DESC Build system root.
#




# First, we pull in the build rules:
include rules.ninja




# Then, we pull in all the subprojects. We use `include` instead of `subninja` so that
# cross-project dependencies work properly.

# bcm2835/ is the subproject that deals with platform support for the BCM2835 SoC, and contains
#          programs to be run on the BCM2835
subninja bcm2835/build.ninja

# pup/ is the subproject that deals with the Program UPloader (PUP). This includes board-specific
# files, the host executable, and platform-specific host code.
subninja pup/build.ninja

# stubs/ are minimal programs used as elementary tests for various other features.
subninja stubs/build.ninja

# libc/ contains libc-provided functionality that the embedded targets expect
subninja libc/build.ninja
