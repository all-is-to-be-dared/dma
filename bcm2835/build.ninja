# -------------------------------------------------------------------------------------------------
# TARGET: bcm2835/libplatform.a

build bcm2835/libplatform.a: arm_mklib $
  build/bcm2835/platform/init.o build/bcm2835/platform/pwrman.o $
  build/bcm2835/platform/uart.o build/bcm2835/platform/gpio.o $
  build/bcm2835/platform/printf.o build/bcm2835/platform/systmr.o $
  build/bcm2835/platform/ptags.o build/bcm2835/platform/extra.o $
  build/bcm2835/platform/backtrace.o build/bcm2835/platform/mmu.o

build build/bcm2835/platform/init.o: arm_cc bcm2835/init.c
build build/bcm2835/platform/pwrman.o: arm_cc bcm2835/pwrman.c
build build/bcm2835/platform/uart.o: arm_cc bcm2835/uart.c
build build/bcm2835/platform/gpio.o: arm_cc bcm2835/gpio.c
build build/bcm2835/platform/systmr.o: arm_cc bcm2835/systmr.c
build build/bcm2835/platform/ptags.o: arm_cc bcm2835/ptags.c
build build/bcm2835/platform/extra.o: arm_cc bcm2835/extra.c
build build/bcm2835/platform/mmu.o: arm_cc bcm2835/mmu.c

build build/bcm2835/platform/backtrace.o: arm_cc generic/backtrace.c

build build/bcm2835/platform/printf.o: arm_cc printf/printf.c

default bcm2835/libplatform.a




# -------------------------------------------------------------------------------------------------
# TARGET: bcm2835/libsanrt.a

build bcm2835/libsanrt.a: arm_mklib $
  build/bcm2835/sanrt/ubsan.o
build build/bcm2835/sanrt/ubsan.o: arm_cc generic/ubsan.c

default bcm2835/libsanrt.a




# --------------------------------------------------------------------------------------------------
# All executable targets

# subninja bcm2835/240-superopt/build.ninja
subninja bcm2835/240-integ/build.ninja
# subninja bcm2835/240-ubsan/build.ninja
