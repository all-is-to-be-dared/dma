c = bcm2835/dma/




# --------------------------------------------------------------------------------------------------
# COMMON SOURCES

build $c/arith.o: bcm2835_cc $c/arith.c

build $c/op_bool_group.o: bcm2835_cc $c/op_bool_group.c
build $c/op_bool_module.o: bcm2835_cc $c/op_bool_module.c
build $c/op_bool_ring.o: bcm2835_cc $c/op_bool_ring.c
build $c/op_int_group.o: bcm2835_cc $c/op_int_group.c
build $c/op_int_relations.o: bcm2835_cc $c/op_int_relations.c
build $c/op_int_ring.o: bcm2835_cc $c/op_int_ring.c
build $c/op_int_eucdom.o: bcm2835_cc $c/op_int_eucdom.c
  
build $c/dma.o: bcm2835_cc $c/dma.c
build $c/dmakit.o: bcm2835_cc $c/dmakit.c
build $c/private.o: bcm2835_cc $c/private.c

# XXX: Ran into a very troublesome linker issue here:
#        If you use AR to make a .a library, then when you link a .o against the .a, anything in the
#        .a that isn't an undefined reference in the .o gets dropped. Thus: do a partial link to
#        make a big .o instead of a .a here; this serves the same purposes and doesn't have the
#        reference issue.
#      Only (reasonable) alternatives were 1) just pass all the dozen-whatever .o files in or
#      2) add --whole-archive $c/libdma.a --no-whole-archive to ldflags_ext and add $c/libdma.a to
#      the non-input dependency list. For obvious reasons, neither of these are preferred solutions.
build $c/plibdma.o: bcm2835_link_partial $
    $c/dma.o $c/dmakit.o $c/private.o $c/arith.o $
    $c/op_bool_group.o $c/op_bool_ring.o $c/op_bool_module.o $
    $c/op_int_group.o $c/op_int_ring.o $c/op_int_eucdom.o $c/op_int_relations.o




# --------------------------------------------------------------------------------------------------
# TARGET: 2-arith-test

build $c/2-arith-test.elf.xz: bcm2835_xz $c/2-arith-test.elf
build $c/2-arith-test.elf: bcm2835_link $c/2-arith-test.o $c/plibdma.o $
  bcm2835/libplatform.a bcm2835/libc.a | bcm2835/common.ld
  ldflags_ext = -Tbcm2835/common.ld
  libs = bcm2835/libgcc.a
build $c/2-arith-test.o: bcm2835_cc $c/2-arith-test.c

default $c/2-arith-test.elf.xz

# --------------------------------------------------------------------------------------------------
# TARGET: 3-riscv-test

build $c/3-riscv-test.elf.xz: bcm2835_xz $c/3-riscv-test.elf
build $c/3-riscv-test.elf: bcm2835_link $c/3-riscv-test.o $c/rv_ima_zicsr_zifencei.o $c/plibdma.o $
  bcm2835/libplatform.a bcm2835/libc.a | bcm2835/common.ld
  ldflags_ext = -Tbcm2835/common.ld
  libs = bcm2835/libgcc.a
build $c/3-riscv-test.o: bcm2835_cc $c/3-riscv-test.c
build $c/rv_ima_zicsr_zifencei.o: bcm2835_cc $c/rv_ima_zicsr_zifencei.c

default $c/3-riscv-test.elf.xz
