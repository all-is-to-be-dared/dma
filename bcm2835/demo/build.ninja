c = bcm2835/demo/

build $c/1-ptags.elf.xz: bcm2835_xz $c/1-ptags.elf
build $c/1-ptags.elf: bcm2835_link $c/1-ptags.o bcm2835/libplatform.a bcm2835/libc.a | bcm2835/common.ld
  ldflags_ext = -Tbcm2835/common.ld
  libs = bcm2835/libgcc.a
build $c/1-ptags.o: bcm2835_cc $c/1-ptags.c

default $c/1-ptags.elf.xz
