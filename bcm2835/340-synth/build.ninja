c = bcm2835/340-synth

# build $c/1-test-bluetooth.elf.xz: arm_xz $c/1-test-bluetooth.elf
# build $c/1-test-bluetooth.elf: arm_link $c/1-test-bluetooth.o bcm2835/libplatform.a bcm2835/libc.a | bcm2835/common.ld
#   ldflags_ext = -Tbcm2835/common.ld
#   libs = bcm2835/libgcc.a
# build $c/1-test-bluetooth.o: arm_cc $c/1-test-bluetooth.c

# default $c/1-test-bluetooth.elf.xz

build $c/1-test-dac.elf.xz: arm_xz $c/1-test-dac.elf
build $c/1-test-dac.elf: arm_link $c/1-test-dac.o bcm2835/libplatform.a bcm2835/libc.a | bcm2835/common.ld
  ldflags_ext = -Tbcm2835/common.ld
  libs = bcm2835/libgcc.a
build $c/1-test-dac.o: arm_cc $c/1-test-dac.c

default $c/1-test-dac.elf.zx
