build bcm2835-dma/240-stream.elf.xz: arm_xz bcm2835-dma/240-stream.elf
build bcm2835-dma/240-stream.elf: arm_link $
  bcm2835-dma/240-stream.o bcm2835/libplatform.a bcm2835/libc.a | bcm2835-dma/common.ld
