# --------------------------------------------------------------------------------------------------
# TARGET: bcm2835-dma/101-scatter

build bcm2835-dma/101-scatter.bin.xz: arm_xz bcm2835-dma/101-scatter.bin
build bcm2835-dma/101-scatter.bin: arm_objcopy bcm2835-dma/101-scatter.elf
build bcm2835-dma/101-scatter.elf: arm_link $
  bcm2835-dma/101-scatter.o bcm2835-dma/libcommon.a | bcm2835-dma/common.ld
  ldflags_ext = -Tbcm2835-dma/common.ld
  libs = bcm2835/libgcc.a
build bcm2835-dma/101-scatter.o: arm_cc bcm2835-dma/101-scatter.c

default bcm2835-dma/101-scatter.bin.xz




# --------------------------------------------------------------------------------------------------
# TARGET: bcm2835-dma/arith_test

build bcm2835-dma/arith_test: phony bcm2835-dma/arith_test.elf.xz bcm2835-dma/arith_test.bin.xz
build bcm2835-dma/arith_test.bin.xz: arm_xz bcm2835-dma/arith_test.bin
build bcm2835-dma/arith_test.bin: arm_objcopy bcm2835-dma/arith_test.elf
build bcm2835-dma/arith_test.elf.xz: arm_xz bcm2835-dma/arith_test.elf
build bcm2835-dma/arith_test.elf: arm_link $
  bcm2835-dma/arith_test.o bcm2835-dma/arith.o bcm2835-dma/libcommon.a | bcm2835-dma/common.ld
  ldflags_ext = -Tbcm2835-dma/common.ld
  libs = bcm2835/libgcc.a
build bcm2835-dma/arith_test.o: arm_cc bcm2835-dma/arith_test.c

default bcm2835-dma/arith_test




